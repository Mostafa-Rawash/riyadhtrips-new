<?php

namespace Modules\Tour\Models;

use App\Currency;
use Illuminate\Http\Request;
use Illuminate\Notifications\Notifiable;
use Illuminate\Support\Arr;
use Illuminate\Support\Carbon;
use Illuminate\Support\Facades\Auth;
use Modules\Booking\Models\Bookable;
use Modules\Booking\Models\Booking;
use Modules\Booking\Traits\CapturesService;
use Modules\Core\Models\Terms;
use Modules\Location\Models\Location;
use Modules\Review\Models\Review;
use Modules\Media\Helpers\FileHelper;
use Illuminate\Support\Facades\Cache;
use Illuminate\Database\Eloquent\SoftDeletes;
use Modules\Core\Models\SEO;
use Modules\User\Models\UserWishList;
use Modules\Core\Models\Attributes;
use Illuminate\Support\Facades\Validator;

class Tour extends Bookable
{
    use Notifiable;
    use SoftDeletes;
    use CapturesService;

    protected $table = 'bravo_tours';
    public $checkout_booking_detail_file = 'Tour::frontend/booking/detail';
    public $checkout_booking_detail_modal_file = 'Tour::frontend/booking/detail-modal';
    public $set_paid_modal_file = 'Tour::frontend/booking/set-paid-modal';
    public $email_new_booking_file = 'Tour::emails.new_booking_detail';
    public $email_new_booking_file_downloads = 'Tour::emails.new_booking_detail_downloads';
    public $type = 'tour';
    
    protected $tourTimeSlotClass;
    
    public function __construct(array $attributes = [])
    {
        parent::__construct($attributes);
        $this->tourTimeSlotClass = TourTimeSlot::class;
    }
    
    /**
     * Relationship with time slots
     */
    public function timeSlots()
    {
        return $this->hasMany($this->tourTimeSlotClass, 'tour_id');
    }

    /**
     * Get time slots for a specific day of week (1=Monday, 7=Sunday)
     */
    public function getTimeSlotsForDay($dayOfWeek)
    {
        return $this->timeSlots()->where('day_of_week', $dayOfWeek)->where('active', 1)->orderBy('start_time')->get();
    }

    /**
     * Get available time slots for a specific date
     */
    public function getAvailableTimeSlots($date)
    {
        // Get day of week for this date (1-7 for Monday-Sunday)
        $dayOfWeek = date('N', strtotime($date));
        
        // Get time slots for this day
        $timeSlots = $this->getTimeSlotsForDay($dayOfWeek);
        
        // Check availability for each time slot
        foreach ($timeSlots as $slot) {
            $slot->remaining_capacity = $slot->getRemainingCapacity($date);
            $slot->is_sold_out = ($slot->remaining_capacity <= 0);
        }
        
        return $timeSlots;
    }
    
    /**
     * Add this modified method to handle time slots in booking validation
     */
    public function addToCartValidate(Request $request)
    {
        $rules = [
            'start_date' => 'required|date_format:Y-m-d',
            'adults' => 'required|integer|min:1',
            'children' => 'required|integer|min:0',
        ];
        
        // Validate time slot if enabled
        if ($this->enable_time_slots) {
            $rules['time_slot_id'] = 'required|integer|exists:bravo_tour_time_slots,id';
            
            // Validate that the time slot belongs to this tour
            $validator = Validator::make($request->all(), $rules);
            
            if ($validator->passes()) {
                $timeSlot = $this->tourTimeSlotClass::find($request->input('time_slot_id'));
                
                if (!$timeSlot || $timeSlot->tour_id != $this->id) {
                    return ['status' => false, 'message' => __('Invalid time slot selected')];
                }
                
                // Check if the time slot is available for the selected date
                $date = $request->input('start_date');
                $dayOfWeek = date('N', strtotime($date));
                
                if ($timeSlot->day_of_week != $dayOfWeek) {
                    return ['status' => false, 'message' => __('This time slot is not available on the selected date')];
                }
                
                // Check if there's enough capacity
                $totalGuests = $request->input('adults') + $request->input('children');
                $remainingCapacity = $timeSlot->getRemainingCapacity($date);
                
                if ($totalGuests > $remainingCapacity) {
                    return [
                        'status' => false,
                        'message' => __('This time slot only has :count spaces remaining', ['count' => $remainingCapacity])
                    ];
                }
            }
        }
        
        $validator = Validator::make($request->all(), $rules);
        if ($validator->fails()) {
            return ['status' => false, 'message' => $validator->errors()->first()];
        }
        return ['status' => true];
    }
    
    /**
     * Get time slot information for a booking
     */
    public function getBookingTimeSlotInfo($booking)
    {
        if (empty($booking->time_slot_id)) {
            return null;
        }
        
        $timeSlot = $this->tourTimeSlotClass::find($booking->time_slot_id);
        if (!$timeSlot) {
            return null;
        }
        
        return [
            'id' => $timeSlot->id,
            'start_time' => $timeSlot->start_time,
            'formatted_time' => $timeSlot->formatted_time,
            'day_of_week' => $timeSlot->day_of_week,
            'day_name' => $timeSlot->day_name
        ];
    }
}